{
  "default": {
    "require": [
      "features/support/**/*.ts",
      "features/step_definitions/**/*.ts"
    ],
    "paths": [
      "features/**/*.feature"
    ],
    "requireModule": ["ts-node/register"],
    "format": [
      "progress-bar",
      "html:cucumber-report.html",
      "json:cucumber-report.json"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  }
}
